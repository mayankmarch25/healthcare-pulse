---
import logo from '../assets/logo.png';
import { Image } from 'astro:assets';
const nav = [
  ['/perspectives/','Perspectives'], ['/about.html','About'],
  ['/podcast.html','Podcast'], ['/archive/','Archive'],
  ['/ask/','Ask'], ['/research/','Research'], ['/index-tool/','Tool'],
];
---
<header class="site-header">
  <a class="logo" href="/">
    <Image src={logo} alt="Healthcare Pulse" class="logo-img" width={52} height={52} />
    <span class="logo-text">
      <span class="logo-name">Healthcare Pulse</span>
      <span class="logo-tag">Digital health, decoded &middot; by Mayank Madhur</span>
    </span>
  </a>
  <button id="navToggle" class="nav-toggle" type="button" aria-label="Open menu" aria-expanded="false">
    <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
  </button>
  <nav id="siteNav">
    {nav.map(([href,label]) => <a href={href}>{label}</a>)}
    <a class="nav-subscribe" href="https://www.linkedin.com/newsletters/7311231782241083393/" target="_blank" rel="noopener">Subscribe</a>
    <button id="themeToggle" class="theme-toggle" type="button" aria-label="Toggle dark mode">
      <svg class="t-sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      <svg class="t-moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
    </button>
  </nav>
</header>
