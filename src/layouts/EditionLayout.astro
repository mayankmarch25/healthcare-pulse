---
import '../styles/hp.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ShareBar from '../components/ShareBar.astro';
import RelatedEditions from '../components/RelatedEditions.astro';
import AuthorBox from '../components/AuthorBox.astro';
import Subscribe from '../components/Subscribe.astro';
import ogDefault from '../assets/og-default.jpg';
import shellUrl from '../scripts/shell.js?url';

const { data, slug, bodyHtml, pageCss, pageScript } = Astro.props;
const url = `https://mayankmadhur.in/${slug}.html`;
const ogImage = new URL(ogDefault.src, Astro.site).href;
const catLabel = data.categoryLabel ?? data.category.replace('-', ' ');

const article = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: data.headTitle ?? `Edition ${data.edition}: ${data.title}`,
  description: data.schemaDescription ?? data.description,
  datePublished: data.datePublished,
  dateModified: data.dateModified ?? data.datePublished,
  url, mainEntityOfPage: { '@type': 'WebPage', '@id': url },
  image: ogImage, inLanguage: 'en',
  author: { '@type': 'Person', name: 'Mayank Madhur',
    url: 'https://www.linkedin.com/in/mayank-madhur/',
    jobTitle: 'Practice Leader, Healthcare & Life Sciences, HFS Research' },
  publisher: { '@type': 'Organization', name: 'Healthcare Pulse',
    logo: { '@type': 'ImageObject', url: ogImage } },
};
const breadcrumb = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Healthcare Pulse', item: 'https://mayankmadhur.in/' },
    { '@type': 'ListItem', position: 2, name: data.breadcrumbSection, item: 'https://mayankmadhur.in/perspectives/' },
    { '@type': 'ListItem', position: 3, name: `Edition ${data.edition}`, item: url },
  ],
};
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{data.headTitle ?? data.title} &middot; Healthcare Pulse</title>
  <meta name="description" content={data.description} />
  <link rel="canonical" href={url} />
  <meta name="author" content="Mayank Madhur" />
  <meta property="og:type" content="article" />
  <meta property="og:site_name" content="Healthcare Pulse" />
  <meta property="og:title" content={data.ogTitle ?? data.headTitle ?? data.title} />
  <meta property="og:description" content={data.ogDescription ?? data.description} />
  <meta property="og:url" content={url} />
  <meta property="og:image" content={ogImage} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content={ogImage} />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <script type="application/ld+json" set:html={JSON.stringify(article)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
  <script is:inline>
    (function(){try{if(localStorage.getItem('hp-theme')==='dark')document.documentElement.setAttribute('data-theme','dark');}catch(e){}})();
  </script>
  {data.needsChart && <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.0/chart.umd.min.js"></script>}
  {pageCss && <style set:html={pageCss} />}
</head>
<body id="top">
  <div id="prog"></div>
  <SiteHeader />
  <main>
    <article class="post">
      <div class={`post-banner cat-${data.category}`}>
        <svg class="banner-ecg" viewBox="0 0 800 220" preserveAspectRatio="xMidYMid slice" aria-hidden="true"><path d="M0 130 H180 l18 -34 22 64 26 -96 24 120 20 -78 16 24 H420 l18 -34 22 64 26 -96 24 120 20 -78 16 24 H800" fill="none" stroke="rgba(255,255,255,.85)" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </div>
      <div class="post-meta">
        <span class="meta-ed">EDITION {data.edition}</span>
        <span>{catLabel.toUpperCase()}</span>
        <span class="meta-cat">{catLabel.replace(/\b\w/g, (c) => c.toUpperCase())}</span>
        {data.readTime && <span>{data.readTime}</span>}
        {data.dateLine && <span class="meta-date" set:html={data.dateLine} />}
      </div>
      <h1 class="post-title">{data.title}</h1>
      <div class="post-body">
        {bodyHtml ? <Fragment set:html={bodyHtml} /> : <slot />}
      </div>
      <ShareBar shareText={`${data.title}. Healthcare Pulse Edition ${data.edition}`} />
      <RelatedEditions label={data.relatedLabel} seeAll={data.relatedSeeAll} items={data.related} />
      <AuthorBox />
      <a class="back-link" href="/perspectives/">&larr; All perspectives</a>
    </article>
  </main>
  <Subscribe />
  <SiteFooter />
  <script is:inline src={shellUrl} defer></script>
  {pageScript && <script is:inline set:html={pageScript} />}
  <script is:inline data-goatcounter="https://mayankmadhur.goatcounter.com/count"
          async src="//gc.zgo.at/count.js"></script>
</body>
</html>
